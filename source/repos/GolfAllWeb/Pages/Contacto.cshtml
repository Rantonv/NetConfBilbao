@page
@model ContactoModel
@{
    ViewData["Title"] = "Contacto";
}

<style>
    .profile-picture {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #e9ecef;
        transition: transform 0.3s ease;
    }

        .profile-picture:hover {
            transform: scale(1.05);
        }

    .card {
        border: none;
        transition: transform 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
        }

    .social-links .btn {
        border-radius: 20px;
        font-size: 0.9em;
    }

        .social-links .btn:hover {
            transform: scale(1.05);
        }
</style>

<div class="container my-5">
    <h1 class="text-center mb-4">Contacto</h1>
    <p class="text-center mb-5">¿Te gustaría contactar para darnos feedback, ampliar catálogo...?</p>

    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <img src="https://avatars.githubusercontent.com/u/6389665?v=4" alt="Software Guzmán"
                         class="profile-picture mb-3" />
                    <h4 class="card-title">Elena Guzmán</h4>
                    <p class="text-muted mb-3">Software developer</p>
                    <div class="social-links">
                        <a href="https://linkedin.com/in/elena-guzman-blanco" target="_blank"
                           class="btn btn-outline-primary btn-sm me-2">
                            <i class="fab fa-linkedin"></i> LinkedIn
                        </a>
                        <a href="https://github.com/beelzenef" target="_blank"
                           class="btn btn-outline-dark btn-sm">
                            <i class="fab fa-github"></i> GitHub
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5 col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <img src="https://avatars.githubusercontent.com/u/222202700?v=4" alt="Raúl Antón"
                         class="profile-picture mb-3" />
                    <h4 class="card-title">Raúl Antón</h4>
                    <p class="text-muted mb-3">Practice Leader</p>
                    <div class="social-links">
                        <a href="https://linkedin.com/in/raul-anton-valverde-92b84920" target="_blank"
                           class="btn btn-outline-primary btn-sm me-2">
                            <i class="fab fa-linkedin"></i> LinkedIn
                        </a>
                        <a href="https://github.com/Rantonv" target="_blank"
                           class="btn btn-outline-dark btn-sm">
                            <i class="fab fa-github"></i> GitHub
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>